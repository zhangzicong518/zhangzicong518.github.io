#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

# Use the same Ruby series as the GitHub Pages build on this Mac.
if [[ -d /opt/homebrew/opt/ruby@3.3/bin ]]; then
  export PATH="/opt/homebrew/opt/ruby@3.3/bin:$PATH"
fi
export PATH="$PWD/.bundle/python/bin:$PATH"

mkdir -p .bundle
cat > .bundle/preview.yml <<'YAML'
url: http://localhost:4000
baseurl: ""
external_sources: []
YAML

exec bundle exec jekyll serve --host 127.0.0.1 --port 4000 \
  --config _config.yml,.bundle/preview.yml "$@"
